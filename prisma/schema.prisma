generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SELLER
  SUPER_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  firstName    String?
  lastName     String?
  phone        String?
  passwordHash String?
  provider     AuthProvider   @default(LOCAL)
  providerId   String?
  role         Role           @default(USER)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  products      Product[]
  orders        Order[]
}

model RefreshToken {
  id                String   @id
  userId            String
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Hardware Models ────────────────────────────────────────────

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum CompatibilityRuleType {
  MUST_MATCH
  RANGE_CHECK
  POWER_SUFFICIENT
  CUSTOM
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products   Product[]
  attributes CategoryAttribute[]
}

model Attribute {
  id           String            @id @default(uuid())
  name         String            @unique
  slug         String            @unique
  dataType     AttributeDataType @default(TEXT)
  unit         String?
  isFilterable Boolean           @default(false)
  isRequired   Boolean           @default(false)
  options      Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  categories              CategoryAttribute[]
  productAttributes       ProductAttribute[]
  compatibilityRulesSource CompatibilityRule[] @relation("SourceAttr")
  compatibilityRulesTarget CompatibilityRule[] @relation("TargetAttr")
}

model CategoryAttribute {
  categoryId  String
  attributeId String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  brand       String?
  model       String?
  sku         String?  @unique
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?
  categoryId  String
  sellerId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category           @relation(fields: [categoryId], references: [id])
  seller     User               @relation(fields: [sellerId], references: [id])
  attributes ProductAttribute[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([slug])
}

model ProductAttribute {
  id          String    @id @default(uuid())
  productId   String
  attributeId String
  value       String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId, value])
}

model CompatibilityRule {
  id                String                @id @default(uuid())
  name              String
  description       String?
  sourceAttributeId String
  targetAttributeId String
  ruleType          CompatibilityRuleType
  condition         Json
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  sourceAttribute Attribute @relation("SourceAttr", fields: [sourceAttributeId], references: [id])
  targetAttribute Attribute @relation("TargetAttr", fields: [targetAttributeId], references: [id])
}

// ─── Orders & Payments Models ────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MOCK
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  status          OrderStatus @default(PENDING_PAYMENT)
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingAddress Json        // JSON flexible para guardar lat/lng, calle, ciudad, etc.
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  documents OrderDocument[]

  @@index([userId])
  @@index([status])
}

enum OrderDocumentType {
  SHIPPING_PROOF
  DELIVERY_PHOTO
  CUSTOMER_SIGNATURE
}

model OrderDocument {
  id           String            @id @default(uuid())
  orderId      String
  documentType OrderDocumentType
  fileUrl      String
  createdAt    DateTime          @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  priceAtTime Decimal  @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String
  provider              PaymentProvider
  providerTransactionId String?         @unique // ID devuelto por Stripe/PayPal (Crítico para Idempotencia)
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(10, 2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerTransactionId])
}
