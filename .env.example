# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # development | production

# ── Base de Datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:123456@localhost:5432/neohw_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera secretos seguros con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900        # 15 minutos (en segundos)
JWT_REFRESH_TTL=1209600   # 14 días (en segundos)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Social Login — Google ─────────────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ── Social Login — Facebook ───────────────────────────────────────────────────
# Obtener en: https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Super Admin (seed inicial) ────────────────────────────────────────────────
# Usado por: npx prisma db seed
# Solo se crea una vez. Si el usuario ya existe, el seed lo omite.
SUPER_ADMIN_EMAIL=admin@tudominio.com
SUPER_ADMIN_PASSWORD=
